# Copy to backend/.env. Everything here can also be set from the dashboard's Settings page.

# Identifies you in the User-Agent of every request (strongly recommended).
CONTACT_EMAIL=

# --- Classification -------------------------------------------------------
# Jev or another classification/decision model is recommended.
# jev (Recommended) = TypeSafe's Jev typed classifier | llm = another model you choose (hosted API or local)
CLASSIFIER=jev
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest
# Optional separate model for classification when CLASSIFIER=llm. Each blank value reuses the
# drafting model's setting (a different base URL never reuses the drafting API key).
CLASSIFIER_LLM_BASE_URL=
CLASSIFIER_LLM_API_KEY=
CLASSIFIER_LLM_MODEL=
CLASSIFIER_LLM_API_FORMAT=auto

# --- LLM for answer drafting and resume import (any model: hosted API or local)
# e.g. Ollama: http://localhost:11434/v1   LM Studio: http://localhost:1234/v1
#      OpenRouter: https://openrouter.ai/api/v1   Anthropic: https://api.anthropic.com/v1
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=
LLM_MODEL=
# auto = Anthropic Messages API for api.anthropic.com, /v1/chat/completions for everything else.
# Set chat_completions or anthropic only when going through a proxy.
LLM_API_FORMAT=auto

# --- Sources --------------------------------------------------------------
ENABLE_GREENHOUSE=true
ENABLE_LEVER=true
ENABLE_ASHBY=true
ENABLE_USAJOBS=false
USAJOBS_API_KEY=
USAJOBS_EMAIL=
ENABLE_ADZUNA=false
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=us

# --- Scheduling (minimum 6 hours) ------------------------------------------
AUTO_SCAN=false
SCAN_INTERVAL_HOURS=12
PREFILTER=loose

# --- Optional read-only browsing ----------------------------------------
BROWSE_ENABLED=false
# cua (Recommended) | playwright
BROWSER=cua
# JSON list of domains or start URLs
BROWSE_DOMAINS=[]
BROWSE_MAX_PAGES_PER_DOMAIN=15

DATA_DIR=data

# --- Security (defaults are right for almost everyone) ---------------------
# Kestrel only answers requests addressed to this computer. Add host names here (comma-separated)
# only if you deliberately put it behind your own reverse proxy.
ALLOWED_HOSTS=
# Interactive API docs at /docs, for development only.
KESTREL_API_DOCS=false
